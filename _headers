# Règles de cache — ob-lepuy.fr
# Fichier lu automatiquement par Cloudflare Pages, à déposer à la racine du dépôt.
#
# Deux points à connaître avant de modifier ce fichier :
#
# 1. Cloudflare ne résout pas les conflits par spécificité de chemin : quand une
#    requête correspond à plusieurs règles, les valeurs sont cumulées. Un en-tête
#    déclaré à la fois ici et dans le bloc /* apparaîtrait donc en double dans la
#    réponse. Chaque en-tête n'est donc défini qu'à un seul endroit.
#
# 2. Ce fichier ne suffit pas seul : le réglage Browser Cache TTL de la zone
#    (Caching > Configuration) doit être sur « Respect Existing Headers », sinon
#    Cloudflare impose sa propre durée par-dessus, quoi qu'on écrive ici.
#
# Les en-têtes ne s'appliquent pas aux réponses des Pages Functions : le point de
# terminaison /api/lead n'est donc pas concerné, ses en-têtes sont définis dans
# functions/api/lead.js.

# --------------------------------------------------- script de consentement
# Porte l'identifiant du pixel et le texte du bandeau : jamais mis en cache
# durablement, sinon une modification reste invisible plusieurs heures.
/consent.js
  Cache-Control: public, max-age=0, must-revalidate

# ------------------------------------------------------------------ pages
# Revérifiées auprès du serveur avant affichage. Cloudflare renvoie un 304
# si rien n'a changé : aucun surcoût de chargement.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/mentions-legales
  Cache-Control: public, max-age=0, must-revalidate

/mentions-legales.html
  Cache-Control: public, max-age=0, must-revalidate

/confidentialite
  Cache-Control: public, max-age=0, must-revalidate

/confidentialite.html
  Cache-Control: public, max-age=0, must-revalidate

/cgv
  Cache-Control: public, max-age=0, must-revalidate

/cgv.html
  Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------- statique
# Réservé aux fichiers versionnés ajoutés plus tard (images, polices).
# Ne rien y placer qui puisse changer sans changer de nom.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------- sécurité
# S'applique à toutes les réponses. À ne pas redéclarer dans les blocs
# ci-dessus, sous peine de doublons dans les en-têtes.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
