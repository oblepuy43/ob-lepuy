# Règles de cache — ob-lepuy.fr
# Fichier lu automatiquement par Cloudflare Pages. À déposer à la racine du dépôt.
#
# IMPORTANT : l'ordre compte. Les règles les plus spécifiques doivent figurer
# AVANT la règle générale /*, sinon cette dernière les neutralise et Cloudflare
# applique ses valeurs par défaut (notamment max-age=14400 sur les fichiers .js).

# ------------------------------------------------------------------- API
# La réponse du formulaire ne doit jamais être mise en cache.
/api/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff

# --------------------------------------------------- script de consentement
# Porte l'identifiant du pixel et le texte du bandeau : jamais mis en cache.
/consent.js
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# ------------------------------------------------------------------ pages
# Revérifiées auprès du serveur avant affichage. Cloudflare renvoie un 304
# si rien n'a changé : aucun surcoût de chargement.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/mentions-legales
  Cache-Control: public, max-age=0, must-revalidate

/mentions-legales.html
  Cache-Control: public, max-age=0, must-revalidate

/confidentialite
  Cache-Control: public, max-age=0, must-revalidate

/confidentialite.html
  Cache-Control: public, max-age=0, must-revalidate

/cgv
  Cache-Control: public, max-age=0, must-revalidate

/cgv.html
  Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------- statique
# Images, polices et fichiers versionnés ajoutés plus tard : cache long.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------- par défaut
# En dernier : s'applique à ce qui n'a pas été capté au-dessus.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
